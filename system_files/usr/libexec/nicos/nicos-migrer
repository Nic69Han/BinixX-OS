#!/usr/bin/python3
"""Récupérer ses fichiers depuis un ancien disque Windows, une clé USB ou un dossier : sans rien écraser.

Usage :
  nicos-migrer sources                              profils Windows trouvés sur les disques montés (JSON)
  nicos-migrer analyser DOSSIER                     ce que contient ce profil ou ce dossier (JSON)
  nicos-migrer copier DOSSIER [--dossiers a,b,…] [--destination DOSSIER] [--json]
  nicos-migrer favoris DOSSIER [--destination DOSSIER]    exporte les favoris Edge, Chrome et Firefox en HTML

Règles : on lit l'ancien disque sans jamais y écrire ; on ne remplace aucun fichier du PC (un fichier de même nom
et de contenu différent est gardé à côté, avec « (depuis Windows) » dans son nom) ; les liens, les fichiers
temporaires et ceux que Windows crée seul (desktop.ini, Thumbs.db…) sont ignorés ; les droits sont normalisés
(un disque NTFS rend tous les fichiers « exécutables »). Les mots de passe du navigateur ne sont pas copiés :
Windows les chiffre pour son propre compte.

Codes de sortie : 0 réussi ; 2 appel incorrect ou dossier introuvable ; 3 pas assez de place ; 5 erreurs de lecture
(le reste a été copié, voir le rapport).
"""

import argparse
import hashlib
import html
import json
import os
import shutil
import sqlite3
import sys
import tempfile
import time

# (clé, titre, noms possibles dans un profil Windows, clé XDG, nom par défaut du dossier du PC)
CATEGORIES = [
    ("documents", "Documents", ("documents", "mes documents", "my documents"), "DOCUMENTS", "Documents"),
    ("bureau", "Bureau", ("desktop", "bureau"), "DESKTOP", "Desktop"),
    ("images", "Images", ("pictures", "images", "mes images", "my pictures"), "PICTURES", "Pictures"),
    ("musique", "Musique", ("music", "musique", "ma musique", "my music"), "MUSIC", "Music"),
    ("videos", "Vidéos", ("videos", "vidéos", "mes vidéos", "my videos"), "VIDEOS", "Videos"),
    ("telechargements", "Téléchargements", ("downloads", "téléchargements"), "DOWNLOAD", "Downloads"),
]
TOUT = "tout"  # dossier quelconque (clé USB…) : copié en entier dans Documents

IGNORES = {"desktop.ini", "thumbs.db", ".ds_store", "$recycle.bin", "system volume information", "ehthumbs.db"}
PROFILS_SYSTEME = {"public", "default", "default user", "all users", "desktop.ini"}
SUFFIXE = " (depuis Windows)"
MARGE_OCTETS = 100 * 1024 * 1024


# --- lecture de l'ancien disque ----------------------------------------------------------------------------------

def sous_chemin(base, *noms):
    """Chemin sous `base` en ignorant la casse (un disque NTFS monté la respecte parfois) ; None s'il n'existe pas."""
    courant = base
    for nom in noms:
        try:
            existants = os.listdir(courant)
        except OSError:
            return None
        trouve = next((e for e in existants if e == nom), None) or next((e for e in sorted(existants)
                                                                         if e.lower() == nom.lower()), None)
        if trouve is None:
            return None
        courant = os.path.join(courant, trouve)
    return courant


def correspondances(base, motif):
    """Sous-dossiers de `base` dont le nom suit un motif « a/b/* » (le dernier * = tous les enfants)."""
    parties = motif.split("/")
    courant = [base]
    for partie in parties:
        suivant = []
        for dossier in courant:
            if partie == "*":
                try:
                    suivant += [os.path.join(dossier, e) for e in sorted(os.listdir(dossier))]
                except OSError:
                    pass
            else:
                trouve = sous_chemin(dossier, partie)
                if trouve:
                    suivant.append(trouve)
        courant = suivant
    return courant


def ignore(nom):
    bas = nom.lower()
    return bas in IGNORES or bas.startswith("~$") or bas.endswith(".tmp")


def parcourir(racine):
    """Fichiers réguliers sous `racine` : (chemin, chemin relatif). Liens et fichiers parasites ignorés."""
    for dossier, noms, fichiers in os.walk(racine, followlinks=False):
        noms[:] = sorted(n for n in noms if not ignore(n) and not os.path.islink(os.path.join(dossier, n)))
        for nom in sorted(fichiers):
            chemin = os.path.join(dossier, nom)
            if ignore(nom) or os.path.islink(chemin) or not os.path.isfile(chemin):
                continue
            yield chemin, os.path.relpath(chemin, racine)


def mesurer(racine):
    """(nombre de fichiers, octets) d'un dossier."""
    fichiers = octets = 0
    for chemin, _ in parcourir(racine):
        try:
            octets += os.path.getsize(chemin)
        except OSError:
            continue
        fichiers += 1
    return fichiers, octets


def dossiers_du_profil(profil):
    """{clé: chemin} des dossiers standard présents dans un profil Windows."""
    trouves = {}
    try:
        enfants = sorted(os.listdir(profil))
    except OSError:
        return trouves
    for cle, _titre, noms, _xdg, _defaut in CATEGORIES:
        for enfant in enfants:
            chemin = os.path.join(profil, enfant)
            if enfant.lower() in noms and os.path.isdir(chemin) and not os.path.islink(chemin):
                trouves[cle] = chemin
                break
    return trouves


def navigateurs(profil):
    """{nom du navigateur: [fichiers de favoris]} trouvés dans un profil Windows."""
    resultat = {}
    for nom, motif, fichier in (
            ("Edge", "AppData/Local/Microsoft/Edge/User Data/*", "Bookmarks"),
            ("Chrome", "AppData/Local/Google/Chrome/User Data/*", "Bookmarks"),
            ("Firefox", "AppData/Roaming/Mozilla/Firefox/Profiles/*", "places.sqlite")):
        liste = []
        for dossier in correspondances(profil, motif):
            trouve = sous_chemin(dossier, fichier)
            if trouve and os.path.isfile(trouve):
                liste.append(trouve)
        if liste:
            resultat[nom] = liste
    return resultat


def analyser(profil, avec_tailles=True):
    """Ce qu'on peut récupérer dans `profil` (profil Windows ou dossier quelconque)."""
    if not os.path.isdir(profil):
        raise FileNotFoundError(profil)
    categories = []
    for cle, chemin in dossiers_du_profil(profil).items():
        titre = next(c[1] for c in CATEGORIES if c[0] == cle)
        fichiers, octets = mesurer(chemin) if avec_tailles else (0, 0)
        categories.append({"cle": cle, "titre": titre, "chemin": chemin, "fichiers": fichiers, "octets": octets})
    if not categories:  # pas un profil Windows : le dossier entier peut être copié dans Documents
        fichiers, octets = mesurer(profil) if avec_tailles else (0, 0)
        categories.append({"cle": TOUT, "titre": os.path.basename(profil.rstrip("/")) or "Dossier", "chemin": profil,
                           "fichiers": fichiers, "octets": octets})
    pst = []
    documents = dossiers_du_profil(profil).get("documents")
    if documents:
        pst = [os.path.relpath(c, profil) for c, _ in parcourir(documents) if c.lower().endswith(".pst")][:20]
    return {"chemin": profil, "nom": os.path.basename(profil.rstrip("/")), "categories": categories,
            "navigateurs": sorted(navigateurs(profil)),
            "onedrive": any(e.lower().startswith("onedrive") for e in _liste(profil)), "pst": pst,
            "profil_windows": any(c["cle"] != TOUT for c in categories)}


def _liste(dossier):
    try:
        return os.listdir(dossier)
    except OSError:
        return []


def trouver_sources(racines=None):
    """Profils Windows des disques et clés montés : [{chemin, nom, disque}]."""
    if racines is None:
        utilisateur = os.environ.get("USER") or os.path.basename(os.path.expanduser("~"))
        racines = [f"/run/media/{utilisateur}", f"/media/{utilisateur}", "/mnt"]
    sources = []
    for racine in racines:
        for disque in sorted(_liste(racine)):
            point = os.path.join(racine, disque)
            if not os.path.isdir(point):
                continue
            candidats = []
            for utilisateurs in correspondances(point, "Users") + correspondances(point, "Windows.old/Users"):
                candidats += [os.path.join(utilisateurs, p) for p in sorted(_liste(utilisateurs))
                              if p.lower() not in PROFILS_SYSTEME]
            if not candidats and len(dossiers_du_profil(point)) >= 2:
                candidats = [point]  # une copie de profil sur une clé USB
            for profil in candidats:
                if os.path.isdir(profil) and dossiers_du_profil(profil):
                    sources.append({"chemin": profil, "nom": os.path.basename(profil.rstrip("/")), "disque": disque})
    return sources


# --- copie ----------------------------------------------------------------------------------------------------------

def lire_dossiers_utilisateur(maison):
    """{clé XDG: chemin} d'après ~/.config/user-dirs.dirs (noms français ou anglais, selon la langue du PC)."""
    resultat = {}
    chemin = os.path.join(os.environ.get("XDG_CONFIG_HOME") or os.path.join(maison, ".config"), "user-dirs.dirs")
    try:
        with open(chemin, encoding="utf-8") as fichier:
            for ligne in fichier:
                ligne = ligne.strip()
                if ligne.startswith("XDG_") and "_DIR=" in ligne:
                    cle, valeur = ligne.split("_DIR=", 1)
                    resultat[cle[4:]] = valeur.strip().strip('"').replace("$HOME", maison)
    except OSError:
        pass
    return resultat


def destination_de(cle, maison):
    """Dossier du PC qui reçoit la catégorie `cle` (Documents pour un dossier quelconque)."""
    xdg = lire_dossiers_utilisateur(maison)
    if cle == TOUT:
        cle = "documents"
    _c, _t, _n, nom_xdg, defaut = next(c for c in CATEGORIES if c[0] == cle)
    return xdg.get(nom_xdg) or os.path.join(maison, defaut)


def _empreinte(chemin):
    resume = hashlib.sha256()
    with open(chemin, "rb") as fichier:
        for bloc in iter(lambda: fichier.read(1024 * 1024), b""):
            resume.update(bloc)
    return resume.hexdigest()


def _identiques(source, cible):
    try:
        if os.path.getsize(source) != os.path.getsize(cible):
            return False
        return _empreinte(source) == _empreinte(cible)
    except OSError:
        return False


def _nom_libre(cible):
    """cible, ou « nom (depuis Windows).ext », ou « nom (depuis Windows 2).ext » : jamais un fichier existant."""
    racine, extension = os.path.splitext(cible)
    candidat = f"{racine}{SUFFIXE}{extension}"
    numero = 1
    while os.path.lexists(candidat):
        numero += 1
        candidat = f"{racine}{SUFFIXE[:-1]} {numero}){extension}"
    return candidat


def _copier_fichier(source, cible):
    os.makedirs(os.path.dirname(cible), mode=0o755, exist_ok=True)
    temporaire = cible + ".nicos-copie"
    shutil.copyfile(source, temporaire)
    try:
        info = os.stat(source)
        os.utime(temporaire, (info.st_atime, info.st_mtime))
    except OSError:
        pass
    os.chmod(temporaire, 0o644)  # un disque NTFS rend tout exécutable
    os.replace(temporaire, cible)


def copier(profil, cles=None, maison=None, evenement=None, destination=None):
    """Copie les catégories `cles` (toutes par défaut) ; renvoie le bilan. `evenement(dict)` suit l'avancement."""
    maison = maison or os.path.expanduser("~")
    evenement = evenement or (lambda _e: None)
    infos = analyser(profil, avec_tailles=False)
    choisies = [c for c in infos["categories"] if cles is None or c["cle"] in cles]
    if not choisies:
        raise ValueError("Aucun dossier à copier.")
    travail = []  # (source, destination)
    octets_total = 0
    for categorie in choisies:
        if destination:  # destination choisie : un sous-dossier par catégorie
            racine_dest = os.path.join(destination, categorie["titre"])
        else:
            racine_dest = destination_de(categorie["cle"], maison)
            if categorie["cle"] == TOUT:
                racine_dest = os.path.join(racine_dest, categorie["titre"])
        for chemin, relatif in parcourir(categorie["chemin"]):
            try:
                octets_total += os.path.getsize(chemin)
            except OSError:
                pass
            travail.append((chemin, os.path.join(racine_dest, relatif)))
    base = destination or maison
    os.makedirs(base, exist_ok=True)
    libre = shutil.disk_usage(base).free
    if octets_total * 1.02 + MARGE_OCTETS > libre:
        raise OSError(f"Pas assez de place : {octets_total // 2**20} Mo à copier, {libre // 2**20} Mo libres.")
    bilan = {"copies": 0, "deja_la": 0, "renommes": [], "erreurs": [], "octets": 0, "total": len(travail)}
    evenement({"etat": "debut", "total": len(travail), "octets_total": octets_total})
    for numero, (source, cible) in enumerate(travail, 1):
        try:
            if os.path.lexists(cible):
                if _identiques(source, cible):
                    bilan["deja_la"] += 1
                    evenement({"etat": "avance", "fait": numero, "total": len(travail), "fichier": cible})
                    continue
                nouveau = _nom_libre(cible)
                bilan["renommes"].append(os.path.relpath(nouveau, base))
                cible = nouveau
            _copier_fichier(source, cible)
            bilan["copies"] += 1
            bilan["octets"] += os.path.getsize(cible)
        except OSError as erreur:
            bilan["erreurs"].append({"fichier": source, "erreur": str(erreur)})
        evenement({"etat": "avance", "fait": numero, "total": len(travail), "fichier": cible})
    bilan["rapport"] = ecrire_rapport(profil, bilan, destination or destination_de("documents", maison))
    evenement({"etat": "fin", "copies": bilan["copies"], "deja_la": bilan["deja_la"], "octets": bilan["octets"],
               "renommes": len(bilan["renommes"]), "erreurs": len(bilan["erreurs"]), "rapport": bilan["rapport"]})
    return bilan


def ecrire_rapport(profil, bilan, dossier):
    os.makedirs(dossier, exist_ok=True)
    chemin = os.path.join(dossier, "Rapport-migration-" + time.strftime("%Y%m%d-%H%M%S") + ".txt")
    lignes = [f"Rapport de migration NicOS - {time.strftime('%d/%m/%Y %H:%M')}", f"Source : {profil}", "",
              f"Fichiers copiés : {bilan['copies']} ({bilan['octets'] // 2**20} Mo)",
              f"Déjà présents (identiques, non recopiés) : {bilan['deja_la']}",
              f"Gardés à côté d'un fichier de même nom (« {SUFFIXE.strip()} ») : {len(bilan['renommes'])}",
              f"Erreurs de lecture : {len(bilan['erreurs'])}", ""]
    if bilan["renommes"]:
        lignes += ["Fichiers renommés :"] + [f"  {r}" for r in bilan["renommes"][:200]] + [""]
    if bilan["erreurs"]:
        lignes += ["Fichiers non copiés :"] + [f"  {e['fichier']} : {e['erreur']}" for e in bilan["erreurs"][:200]]
    with open(chemin, "w", encoding="utf-8") as fichier:
        fichier.write("\n".join(lignes) + "\n")
    return chemin


# --- favoris ------------------------------------------------------------------------------------------------------

def _noeud_json(noeud):
    """Arbre de favoris Chrome/Edge : ('dossier', nom, [enfants]) ou ('lien', titre, adresse)."""
    if noeud.get("type") == "url":
        return ("lien", noeud.get("name", ""), noeud.get("url", ""))
    return ("dossier", noeud.get("name", ""), [_noeud_json(e) for e in noeud.get("children", [])])


def favoris_chromium(chemin):
    with open(chemin, encoding="utf-8") as fichier:
        racines = json.load(fichier).get("roots", {})
    enfants = []
    for cle in ("bookmark_bar", "other", "synced"):
        if cle in racines and racines[cle].get("children"):
            enfants.append(_noeud_json(racines[cle]))
    return enfants


RACINES_FIREFOX = {"menu________": "Menu des favoris", "toolbar_____": "Barre personnelle",
                   "unfiled_____": "Autres favoris", "mobile______": "Favoris mobiles"}


def favoris_firefox(chemin):
    """Favoris d'un profil Firefox (places.sqlite lu en copie : la base peut être verrouillée)."""
    with tempfile.TemporaryDirectory() as tmp:
        copie = os.path.join(tmp, "places.sqlite")
        shutil.copyfile(chemin, copie)
        for suffixe in ("-wal", "-shm"):
            if os.path.exists(chemin + suffixe):
                shutil.copyfile(chemin + suffixe, copie + suffixe)
        base = sqlite3.connect(copie)
        try:
            lignes = base.execute(
                "SELECT b.id, b.parent, b.type, b.title, p.url, b.guid FROM moz_bookmarks b "
                "LEFT JOIN moz_places p ON b.fk = p.id ORDER BY b.parent, b.position").fetchall()
        finally:
            base.close()
    enfants = {}
    for ident, parent, genre, titre, adresse, guid in lignes:
        enfants.setdefault(parent, []).append((ident, genre, titre, adresse, guid))

    def construire(parent):
        resultat = []
        for ident, genre, titre, adresse, guid in enfants.get(parent, []):
            if guid == "tags________":  # les étiquettes répètent les favoris : on ne les exporte pas
                continue
            if genre == 2:
                sous = construire(ident)
                if sous:
                    resultat.append(("dossier", RACINES_FIREFOX.get(guid) or titre or "", sous))
            elif genre == 1 and adresse and adresse.startswith(("http://", "https://", "ftp://")):
                resultat.append(("lien", titre or adresse, adresse))
        return resultat

    racine = next((i for i, p, g, _t, _a, _g in lignes if p == 0 and g == 2), 1)
    return construire(racine)


def _html(noeuds, niveau=1):
    marge = "    " * niveau
    sortie = []
    for genre, nom, contenu in noeuds:
        if genre == "dossier":
            sortie.append(f"{marge}<DT><H3>{html.escape(nom)}</H3>")
            sortie.append(f"{marge}<DL><p>")
            sortie += _html(contenu, niveau + 1)
            sortie.append(f"{marge}</DL><p>")
        else:
            sortie.append(f'{marge}<DT><A HREF="{html.escape(contenu, quote=True)}">{html.escape(nom)}</A>')
    return sortie


def exporter_favoris(profil, maison=None, destination=None):
    """Écrit un fichier HTML que Firefox sait importer ; renvoie (chemin, nombre de liens) ou (None, 0)."""
    maison = maison or os.path.expanduser("~")
    dossiers = []
    for nom, fichiers in navigateurs(profil).items():
        for fichier in fichiers:
            try:
                arbre = favoris_firefox(fichier) if nom == "Firefox" else favoris_chromium(fichier)
            except (OSError, ValueError, sqlite3.Error):
                continue
            if arbre:
                titre = nom if len(fichiers) == 1 else f"{nom} ({os.path.basename(os.path.dirname(fichier))})"
                dossiers.append(("dossier", f"Favoris {titre}", arbre))

    def compter(noeuds):
        return sum(compter(c) if g == "dossier" else 1 for g, _n, c in noeuds)

    total = compter(dossiers)
    if not total:
        return None, 0
    dossier = destination or destination_de("documents", maison)
    os.makedirs(dossier, exist_ok=True)
    chemin = os.path.join(dossier, "Favoris-depuis-Windows-" + time.strftime("%Y%m%d-%H%M%S") + ".html")
    lignes = ["<!DOCTYPE NETSCAPE-Bookmark-file-1>", '<META HTTP-EQUIV="Content-Type" CONTENT="text/html; charset=UTF-8">',
              "<TITLE>Favoris</TITLE>", "<H1>Favoris</H1>", "<DL><p>", *_html(dossiers), "</DL><p>"]
    with open(chemin, "w", encoding="utf-8") as fichier:
        fichier.write("\n".join(lignes) + "\n")
    os.chmod(chemin, 0o644)
    return chemin, total


# --- ligne de commande --------------------------------------------------------------------------------------------

def main(argv):
    analyseur = argparse.ArgumentParser(prog="nicos-migrer", add_help=False)
    analyseur.add_argument("commande", nargs="?")
    analyseur.add_argument("dossier", nargs="?")
    analyseur.add_argument("--dossiers")
    analyseur.add_argument("--destination")
    analyseur.add_argument("--json", action="store_true")
    try:
        args = analyseur.parse_args(argv)
    except SystemExit:
        print(__doc__, file=sys.stderr)
        return 2
    if args.commande == "sources" and not args.dossier:
        print(json.dumps(trouver_sources(), ensure_ascii=False))
        return 0
    if args.commande in ("analyser", "copier", "favoris") and args.dossier:
        if not os.path.isdir(args.dossier):
            print(f"Dossier introuvable : {args.dossier}", file=sys.stderr)
            return 2
        if args.commande == "analyser":
            print(json.dumps(analyser(args.dossier), ensure_ascii=False))
            return 0
        if args.commande == "favoris":
            chemin, total = exporter_favoris(args.dossier, destination=args.destination)
            print(json.dumps({"fichier": chemin, "liens": total}, ensure_ascii=False))
            return 0
        cles = args.dossiers.split(",") if args.dossiers else None

        def evenement(donnees):
            if args.json:
                print(json.dumps(donnees, ensure_ascii=False), flush=True)

        try:
            bilan = copier(args.dossier, cles, evenement=evenement, destination=args.destination)
        except ValueError as erreur:
            print(erreur, file=sys.stderr)
            return 2
        except OSError as erreur:
            print(erreur, file=sys.stderr)
            return 3
        if not args.json:
            print(f"{bilan['copies']} fichier(s) copié(s), {bilan['deja_la']} déjà présent(s), "
                  f"{len(bilan['renommes'])} gardé(s) à côté, {len(bilan['erreurs'])} erreur(s). Rapport : {bilan['rapport']}")
        return 5 if bilan["erreurs"] else 0
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
