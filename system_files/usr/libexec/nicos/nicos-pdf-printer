#!/usr/bin/bash
# Crée l'imprimante virtuelle « Cups-PDF » (les PDF arrivent sur le Bureau de l'utilisateur).
# Lancé une seule fois par nicos-pdf-printer.service, au premier démarrage.
#
# Lancé directement par l'unité, lpadmin échouait au premier démarrage (test VM) :
# SELinux l'étiquette lpr_exec_t, un type prévu pour les sessions utilisateur. Ce script
# (bin_t) tourne comme un service ordinaire, et attend en plus que CUPS réponde.

set -euo pipefail

# cupsd peut mettre quelques secondes à répondre après son démarrage
for _ in {1..30}; do
    lpstat -r >/dev/null 2>&1 && break
    sleep 2
done

if lpstat -p Cups-PDF >/dev/null 2>&1; then
    echo "L'imprimante Cups-PDF existe déjà."
    exit 0
fi

# Même commande que le paquet cups-pdf, qui ne peut pas l'exécuter pendant le build de l'image
lpadmin -p Cups-PDF -D "Imprimante PDF" -L "Fichiers PDF enregistrés sur le Bureau" \
    -v cups-pdf:/ -m CUPS-PDF_noopt.ppd -E
echo "Imprimante Cups-PDF créée."
