#!/usr/bin/bash
# Installe (pour tout le système) les applications Flatpak listées dans l'image.
# Lancé par nicos-flatpak-install.service. Ne fait rien si la liste n'a pas changé
# depuis la dernière installation réussie, pour ne pas réinstaller une application
# que l'utilisateur a volontairement supprimée.
# Une image dérivée (par exemple celle d'une entreprise, voir entreprise/) ajoute ses applications
# dans /usr/share/nicos/flatpaks/system-flatpaks.d/*.list sans toucher à la liste de NicOS.

set -euo pipefail

LIST=/usr/share/nicos/flatpaks/system-flatpaks.list
LIST_DIR=/usr/share/nicos/flatpaks/system-flatpaks.d
STATE_DIR=/var/lib/nicos
STAMP="${STATE_DIR}/flatpaks.sha256"
REMOTE=flathub

lists=("${LIST}")
shopt -s nullglob
lists+=("${LIST_DIR}"/*.list)
shopt -u nullglob

list_hash="$(cat "${lists[@]}" | sha256sum | cut -d' ' -f1)"
if [[ -f "${STAMP}" && "$(<"${STAMP}")" == "${list_hash}" ]]; then
    echo "Liste Flatpak inchangée, rien à faire."
    exit 0
fi

# Normalement ajouté par flatpak-add-flathub-repos.service (image de base Universal Blue)
flatpak remote-add --system --if-not-exists "${REMOTE}" https://dl.flathub.org/repo/flathub.flatpakrepo

# Seule source d'applications : Flathub (pas de source « Fedora » dans Discover)
for remote in fedora fedora-testing; do
    if flatpak remotes --system --columns=name | grep -qxF "${remote}"; then
        flatpak remote-delete --system "${remote}" || echo "Source ${remote} conservée : des applications en dépendent"
    fi
done

mapfile -t wanted < <(sed -e 's/#.*//' -e 's/[[:space:]]//g' -e '/^$/d' "${lists[@]}" | sort -u)
mapfile -t installed < <(flatpak list --system --app --columns=application)

missing=()
for app in "${wanted[@]}"; do
    if ! printf '%s\n' "${installed[@]}" | grep -qxF "${app}"; then
        missing+=("${app}")
    fi
done

if [[ ${#missing[@]} -gt 0 ]]; then
    echo "Installation de : ${missing[*]}"
    flatpak install --system --noninteractive --assumeyes "${REMOTE}" "${missing[@]}"
else
    echo "Toutes les applications sont déjà installées."
fi

mkdir -p "${STATE_DIR}"
echo "${list_hash}" >"${STAMP}"
