#!/usr/bin/python3
"""Clé de récupération du disque chiffré (LUKS2) : liste les volumes chiffrés, crée ou remplace la clé.

Usage :
  binixx-cle-recuperation volumes                           liste (JSON), sans droit particulier
  binixx-cle-recuperation creer PERIPHERIQUE [--remplacer]  mot de passe actuel du disque sur l'entrée standard

« creer » demande les droits d'administrateur (pkexec, voir org.binixx.cle-recuperation.policy). Le mot de
passe ne passe jamais par la ligne de commande : entrée standard, puis variable d'environnement du seul
processus systemd-cryptenroll. La clé créée est écrite sur la sortie standard, sous la forme « CLE=… » ;
les messages vont sur la sortie d'erreur.

Codes de sortie : 0 réussi ; 2 appel incorrect ou volume inconnu ; 3 une clé de récupération existe déjà
(refaire avec --remplacer) ; 4 mot de passe refusé ; 5 autre échec (format non pris en charge, outil absent…).
"""

import json
import os
import re
import shutil
import subprocess
import sys

CRYPTENROLL = shutil.which("systemd-cryptenroll") or "/usr/bin/systemd-cryptenroll"
# Une clé de récupération de systemd : huit groupes de huit lettres (alphabet « modhex »), séparés par des tirets.
# Sortie standard redirigée : la clé est seule sur sa ligne ; sur un terminal, elle est indentée dans un message.
MOTIF_CLE = re.compile(r"^\s*([a-z]{8}(?:-[a-z]{8}){7})\s*$", re.MULTILINE)


def lsblk():
    """Arbre des périphériques de bloc, tel que le donne lsblk (dictionnaire JSON)."""
    fini = subprocess.run(["lsblk", "-J", "-p", "-o", "PATH,TYPE,FSTYPE,SIZE,MOUNTPOINTS"], capture_output=True,
                          text=True, timeout=30, check=False)
    if fini.returncode != 0:
        raise OSError(fini.stderr.strip() or "lsblk a échoué")
    return json.loads(fini.stdout)


def _montages(noeud):
    """Points de montage d'un périphérique et de tout ce qui est construit dessus."""
    trouves = [m for m in (noeud.get("mountpoints") or []) if m]
    for enfant in noeud.get("children") or []:
        trouves += _montages(enfant)
    return trouves


def _parcourir(noeuds):
    for noeud in noeuds:
        yield noeud
        yield from _parcourir(noeud.get("children") or [])


def volumes(arbre):
    """Volumes LUKS de l'arbre lsblk : chemin, taille, points de montage, « systeme » si « / » en dépend."""
    resultat = []
    for noeud in _parcourir(arbre.get("blockdevices") or []):
        if noeud.get("fstype") == "crypto_LUKS":
            montages = _montages(noeud)
            resultat.append({"chemin": noeud["path"], "taille": noeud.get("size") or "", "montages": montages,
                             "systeme": "/" in montages})
    return resultat


def cle_dans(sortie):
    """La clé de récupération affichée par systemd-cryptenroll, ou None."""
    trouve = MOTIF_CLE.search(sortie)
    return trouve.group(1) if trouve else None


def emplacements(texte):
    """Types de méthodes de déverrouillage de la liste de systemd-cryptenroll : {numéro: type}."""
    resultat = {}
    for ligne in texte.splitlines():
        champs = ligne.split()
        if len(champs) == 2 and champs[0].isdigit():
            resultat[int(champs[0])] = champs[1]
    return resultat


def _environnement(mot_de_passe=None):
    env = {"PATH": "/usr/sbin:/usr/bin:/sbin:/bin", "LC_ALL": "C"}  # sortie en anglais : analysée plus bas
    if mot_de_passe is not None:
        env["PASSWORD"] = mot_de_passe
    return env


def _cryptenroll(args, mot_de_passe=None):
    return subprocess.run([CRYPTENROLL, *args], capture_output=True, text=True, timeout=300, check=False,
                          stdin=subprocess.DEVNULL, env=_environnement(mot_de_passe))


def creer(peripherique, remplacer, mot_de_passe):
    """Crée (ou remplace) la clé de récupération ; renvoie (code de sortie, clé ou message)."""
    try:
        connus = {v["chemin"] for v in volumes(lsblk())}
    except (OSError, ValueError, subprocess.TimeoutExpired) as erreur:
        return 5, f"Impossible de lister les disques : {erreur}"
    if peripherique not in connus:
        return 2, f"{peripherique} n'est pas un volume chiffré de ce PC."
    try:
        liste = _cryptenroll([peripherique])
    except (OSError, subprocess.TimeoutExpired) as erreur:
        return 5, f"systemd-cryptenroll : {erreur}"
    if liste.returncode != 0:
        return 5, "Ce volume n'a pas le format LUKS2, la clé de récupération n'est pas possible. " + liste.stderr.strip()
    if "recovery" in emplacements(liste.stdout).values() and not remplacer:
        return 3, "Une clé de récupération existe déjà pour ce disque."
    args = ["--recovery-key", *(["--wipe-slot=recovery"] if remplacer else []), peripherique]
    try:
        fini = _cryptenroll(args, mot_de_passe)
    except (OSError, subprocess.TimeoutExpired) as erreur:
        return 5, f"systemd-cryptenroll : {erreur}"
    if fini.returncode != 0:
        if "did not work" in fini.stderr or "Operation not permitted" in fini.stderr:
            return 4, "Mot de passe refusé."
        return 5, fini.stderr.strip() or "La création de la clé a échoué."
    cle = cle_dans(fini.stdout) or cle_dans(fini.stderr)
    if cle is None:
        return 5, "La clé a été créée mais n'a pas pu être lue ; refaites l'opération avec « remplacer »."
    return 0, cle


def main(argv):
    commande = argv[0] if argv else ""
    if commande == "volumes" and len(argv) == 1:
        try:
            print(json.dumps(volumes(lsblk()), ensure_ascii=False))
        except (OSError, ValueError, subprocess.TimeoutExpired) as erreur:
            print(f"Impossible de lister les disques : {erreur}", file=sys.stderr)
            return 5
        return 0
    if commande == "creer" and len(argv) in (2, 3) and (len(argv) == 2 or argv[2] == "--remplacer"):
        if os.geteuid() != 0:
            print("Cette commande demande les droits d'administrateur (pkexec).", file=sys.stderr)
            return 2
        mot_de_passe = sys.stdin.readline().rstrip("\n")
        if not mot_de_passe:
            print("Le mot de passe du disque est attendu sur l'entrée standard.", file=sys.stderr)
            return 2
        code, resultat = creer(argv[1], len(argv) == 3, mot_de_passe)
        if code == 0:
            print(f"CLE={resultat}")
        else:
            print(resultat, file=sys.stderr)
        return code
    print(__doc__, file=sys.stderr)
    return 2


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
