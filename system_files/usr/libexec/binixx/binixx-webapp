#!/usr/bin/bash
# Ouvre un service web (Teams, Zoom, Slack…) dans sa propre fenêtre, sans barre d'adresse,
# comme une application installée. Usage : binixx-webapp <url>
#
# Chromium (Flatpak) sert de moteur : sous Wayland, il partage l'écran via PipeWire et le
# portail KDE. S'il n'est pas (encore) installé, l'adresse s'ouvre dans le navigateur par défaut.

set -euo pipefail

url="${1:?usage: binixx-webapp <url>}"

if flatpak info org.chromium.Chromium >/dev/null 2>&1; then
    exec flatpak run org.chromium.Chromium --app="${url}"
fi

exec xdg-open "${url}"
