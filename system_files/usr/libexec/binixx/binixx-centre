#!/usr/bin/python3
"""Lance le Centre BinixX OS (accueil, catalogue des logiciels Windows, aide)."""

import os
import sys

# Accueil (lancé à chaque ouverture de session) déjà vu : on sort avant de charger Qt et toutes les pages, qui coûtent une seconde
# et une centaine de Mo à chaque connexion. Même marqueur que binixx_centre.app.PREMIER_DEMARRAGE.
if "--premier-demarrage" in sys.argv[1:] and os.path.exists(os.path.join(
        os.environ.get("XDG_CONFIG_HOME") or os.path.expanduser("~/.config"), "binixx", "accueil-vu")):
    sys.exit(0)

sys.path.insert(0, "/usr/lib/binixx/centre")

from binixx_centre.app import main  # noqa: E402

sys.exit(main())
