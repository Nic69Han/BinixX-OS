#!/usr/bin/bash
# Installe (pour tout le système) les applications Flatpak listées dans l'image.
# Lancé par binixx-flatpak-install.service. Ne fait rien si la liste n'a pas changé
# depuis la dernière installation réussie, pour ne pas réinstaller une application
# que l'utilisateur a volontairement supprimée.
# Une image dérivée (par exemple celle d'une entreprise, voir entreprise/) ajoute ses applications
# dans /usr/share/binixx/flatpaks/system-flatpaks.d/*.list sans toucher à la liste de BinixX OS.

set -euo pipefail

LIST=/usr/share/binixx/flatpaks/system-flatpaks.list
LIST_DIR=/usr/share/binixx/flatpaks/system-flatpaks.d
STATE_DIR=/var/lib/binixx
STAMP="${STATE_DIR}/flatpaks.sha256"
REMOTE=flathub

lists=("${LIST}")
shopt -s nullglob
lists+=("${LIST_DIR}"/*.list)
shopt -u nullglob

# Applications Flatpak GTK (Thunderbird, Remmina, Déjà Dup…) comme celles du système : elles lisent, en lecture seule, les
# réglages GTK que kde-gtk-config écrit à chaque ouverture de session (couleurs BinixX, police, icônes) ; à chaque démarrage,
# c'est instantané et sans réseau. docs/applications-unifiees.md
flatpak override --system --filesystem=xdg-config/gtk-3.0:ro --filesystem=xdg-config/gtk-4.0:ro

# Normalement ajouté par flatpak-add-flathub-repos.service (image de base Universal Blue)
flatpak remote-add --system --if-not-exists "${REMOTE}" https://dl.flathub.org/repo/flathub.flatpakrepo

# Thème Breeze pour les applications Flatpak en GTK 3 (une extension de Flathub) ; les applications GTK 4 (libadwaita)
# prennent le bleu BinixX et le mode clair ou sombre par le portail de KDE. Sans réseau ou si Flathub le refuse, les
# applications restent installées, avec le thème par défaut de GTK.
if ! flatpak info --system org.gtk.Gtk3theme.Breeze >/dev/null 2>&1; then
    flatpak install --system --noninteractive --assumeyes "${REMOTE}" org.gtk.Gtk3theme.Breeze ||
        echo "Thème Breeze pour les Flatpak GTK 3 non installé (réessayé au prochain démarrage)"
fi

list_hash="$(cat "${lists[@]}" | sha256sum | cut -d' ' -f1)"
if [[ -f "${STAMP}" && "$(<"${STAMP}")" == "${list_hash}" ]]; then
    echo "Liste Flatpak inchangée, rien à faire."
    exit 0
fi

# Seule source d'applications : Flathub (pas de source « Fedora » dans Discover)
for remote in fedora fedora-testing; do
    if flatpak remotes --system --columns=name | grep -qxF "${remote}"; then
        flatpak remote-delete --system "${remote}" || echo "Source ${remote} conservée : des applications en dépendent"
    fi
done

mapfile -t wanted < <(sed -e 's/#.*//' -e 's/[[:space:]]//g' -e '/^$/d' "${lists[@]}" | sort -u)
mapfile -t installed < <(flatpak list --system --app --columns=application)

missing=()
for app in "${wanted[@]}"; do
    if ! printf '%s\n' "${installed[@]}" | grep -qxF "${app}"; then
        missing+=("${app}")
    fi
done

if [[ ${#missing[@]} -gt 0 ]]; then
    echo "Installation de : ${missing[*]}"
    flatpak install --system --noninteractive --assumeyes "${REMOTE}" "${missing[@]}"
else
    echo "Toutes les applications sont déjà installées."
fi

mkdir -p "${STATE_DIR}"
echo "${list_hash}" >"${STAMP}"
