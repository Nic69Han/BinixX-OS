#!/usr/bin/bash
# Rapport de diagnostic à joindre à une demande d'aide : état du système, de la dernière mise à jour,
# des services en échec, des erreurs récentes, du réseau, des disques et du matériel.
#
# Écrit sur la sortie standard. Ne demande aucun droit particulier, ne modifie rien et ne contient ni
# mot de passe, ni contenu de fichier, ni adresse IP, ni nom de réseau Wi-Fi. Le Centre BinixX OS (page Aide)
# l'enregistre dans le dossier Documents ; l'utilisateur le relit avant de l'envoyer.

set -uo pipefail

section() { printf '\n== %s ==\n' "$*"; }
# run <commande...> : exécute si la commande existe, sinon l'indique ; ne fait jamais échouer le rapport
run() {
    if command -v "$1" >/dev/null 2>&1; then
        "$@" 2>&1 || printf '(la commande « %s » a échoué)\n' "$*"
    else
        printf '(« %s » absent)\n' "$1"
    fi
}

printf 'Rapport de diagnostic BinixX OS\n'
printf 'Date : %s\n' "$(date '+%Y-%m-%d %H:%M:%S %Z')"

section "Système"
if [[ -r /usr/lib/os-release ]]; then
    # shellcheck source=/dev/null  # fichier du système, absent du dépôt
    (. /usr/lib/os-release && printf '%s (%s)\n' "${PRETTY_NAME:-?}" "${VARIANT:-sans variante}")
fi
printf 'Noyau : %s\n' "$(uname -r)"
printf 'Langue : %s\n' "${LANG:-?}"
printf 'Session : %s\n' "${XDG_SESSION_TYPE:-?}"

section "Mises à jour (image du système)"
run rpm-ostree status --booted

section "Services en échec"
run systemctl --failed --no-legend --plain
printf -- '-- utilisateur --\n'
run systemctl --user --failed --no-legend --plain

section "Erreurs récentes du démarrage en cours (80 dernières lignes)"
if command -v journalctl >/dev/null 2>&1; then
    journalctl -b -p err --no-pager -n 80 -o short-monotonic 2>&1 | tail -n 80
else
    printf '(journalctl absent)\n'
fi

section "Espace disque"
run df -h -x tmpfs -x devtmpfs -x efivarfs
run lsblk -o NAME,SIZE,TYPE,FSTYPE,MOUNTPOINTS

section "Mémoire et processeur"
run free -h
if command -v lscpu >/dev/null 2>&1; then lscpu | grep -E 'Model name|^CPU\(s\)'; fi

section "Réseau (état seulement)"
run nmcli -t -f DEVICE,TYPE,STATE device

section "Matériel (cartes graphiques, réseau, son)"
if command -v lspci >/dev/null 2>&1; then
    lspci -nn | grep -Ei 'vga|3d|display|network|ethernet|audio'
else
    printf '(lspci absent)\n'
fi

section "Imprimantes"
run lpstat -p

section "Applications Flatpak installées"
run flatpak list --app --columns=application,version

# Pourquoi une application manque (« Aucune entrée pour… » dans Discover, bouton « Installer » sans effet) : la source Flathub
# est-elle déclarée et joignable, le catalogue est-il téléchargé, le service du premier démarrage a-t-il fini ou échoué ?
section "Applications : source Flathub et installation au premier démarrage"
dossier_flatpaks="${BINIXX_FLATPAKS_DIR:-/usr/share/binixx/flatpaks}"
dossier_etat="${BINIXX_ETAT_DIR:-/var/lib/binixx}"
run flatpak remotes --system --columns=name,options
listes=()
for liste in "${dossier_flatpaks}/system-flatpaks.list" "${dossier_flatpaks}"/system-flatpaks.d/*.list; do
    if [[ -r "${liste}" ]]; then listes+=("${liste}"); fi
done
if [[ ${#listes[@]} -gt 0 ]] && command -v flatpak >/dev/null 2>&1; then
    mapfile -t prevues < <(sed -e 's/#.*//' -e 's/[[:space:]]//g' -e '/^$/d' "${listes[@]}" | sort -u)
    mapfile -t presentes < <(flatpak list --system --app --columns=application 2>/dev/null)
    manquantes=()
    for appli in "${prevues[@]}"; do
        if ! printf '%s\n' "${presentes[@]}" | grep -qxF "${appli}"; then manquantes+=("${appli}"); fi
    done
    printf 'Applications prévues d'\''office : %d ; manquantes : %d%s\n' "${#prevues[@]}" "${#manquantes[@]}" \
        "$([[ ${#manquantes[@]} -gt 0 ]] && printf ' (%s)' "${manquantes[*]}")"
else
    printf '(liste des applications prévues ou flatpak absents)\n'
fi
if [[ -f "${dossier_etat}/flatpaks.sha256" ]]; then
    printf 'Installation des applications prévues : terminée (le %s)\n' "$(date -r "${dossier_etat}/flatpaks.sha256" '+%Y-%m-%d %H:%M')"
else
    printf 'Installation des applications prévues : pas encore terminée\n'
fi
run systemctl show binixx-flatpak-install.service --no-pager -p ActiveState -p SubState -p Result -p NRestarts -p ExecMainStatus
printf -- '-- catalogue des applications (taille, date) --\n'
catalogues=(/var/lib/flatpak/appstream/flathub/*/active/appstream.xml.gz)
if [[ -e "${catalogues[0]}" ]]; then
    stat -c '%s octets, %y' "${catalogues[@]}" | cut -c1-40
else
    printf 'aucun : Discover ne trouvera pas les applications de Flathub\n'
fi
# Seul le code de réponse est gardé : ni adresse, ni contenu
if command -v curl >/dev/null 2>&1; then
    code="$(curl -s -o /dev/null -w '%{http_code}' --max-time 8 https://dl.flathub.org/repo/flathub.flatpakrepo 2>/dev/null)"
    if [[ "${code}" == "200" ]]; then
        printf 'Flathub joignable depuis ce PC : oui\n'
    else
        printf 'Flathub joignable depuis ce PC : non (code %s)\n' "${code:-aucun}"
    fi
fi
printf -- '-- journal du service d'\''installation (40 dernières lignes) --\n'
if command -v journalctl >/dev/null 2>&1; then
    journalctl -u binixx-flatpak-install.service -b --no-pager -n 40 -o short-monotonic 2>&1 | tail -n 40
else
    printf '(journalctl absent)\n'
fi

section "Réglages du système modifiés depuis l'installation (noms des fichiers seulement)"
run /usr/libexec/binixx/binixx-reparer-systeme liste --texte

printf '\nFin du rapport.\n'
