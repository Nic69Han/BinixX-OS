[Desktop Entry]
Type=Application
Name=Récupérer mes fichiers Windows
GenericName=Migration depuis Windows
Comment=Copier ses documents, photos, musique et favoris depuis l'ancien disque Windows, une clé USB ou un dossier
Exec=/usr/libexec/nicos/nicos-centre --page migration
Icon=document-import
Terminal=false
Categories=System;Utility;
Keywords=windows;migration;migrer;fichiers;documents;récupérer;ancien disque;favoris;transfert;importer;
StartupNotify=true
StartupWMClass=nicos-centre
