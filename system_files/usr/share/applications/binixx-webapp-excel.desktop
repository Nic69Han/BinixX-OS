[Desktop Entry]
Type=Application
Name=Excel (web)
GenericName=Tableur Microsoft 365 (web)
Comment=Classeurs Excel en ligne, enregistrés sur OneDrive
Exec=/usr/libexec/binixx/binixx-webapp https://excel.cloud.microsoft/
Icon=x-office-spreadsheet
Terminal=false
Categories=Office;
Keywords=excel;microsoft;365;tableur;xlsx;
StartupNotify=true
# Classe de fenêtre de Chromium en mode application, pour grouper la fenêtre sous cette icône
StartupWMClass=chrome-excel.cloud.microsoft__-Default
