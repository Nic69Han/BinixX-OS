[Desktop Entry]
Type=Application
Name=Capturer une zone de l'écran
GenericName=Capture d'écran d'une partie de l'écran
Comment=Dessinez un rectangle : Spectacle s'ouvre pour copier ou enregistrer l'image (comme Windows + Maj + S)
Exec=spectacle --region
Icon=spectacle
Terminal=false
Categories=Graphics;
Keywords=capture;capture d'écran;outil capture;snipping tool;windows maj s;zone;
X-KDE-Shortcuts=Meta+Shift+S
