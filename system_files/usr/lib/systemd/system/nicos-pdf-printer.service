[Unit]
Description=NicOS : création de l'imprimante virtuelle PDF
Documentation=https://github.com/Nic69Han/NicOS
Wants=cups.service
After=cups.service
# Une fois créée, l'imprimante est enregistrée par CUPS dans /etc/cups ;
# l'utilisateur reste libre de la supprimer ensuite.
ConditionPathExists=!/var/lib/nicos/pdf-printer.done

[Service]
Type=oneshot
ExecStart=/usr/libexec/nicos/nicos-pdf-printer
ExecStartPost=/usr/bin/mkdir -p /var/lib/nicos
ExecStartPost=/usr/bin/touch /var/lib/nicos/pdf-printer.done

[Install]
WantedBy=multi-user.target
