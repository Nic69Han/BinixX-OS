[Unit]
Description=NicOS : installation des applications Flatpak par défaut
Documentation=https://github.com/Nic69Han/NicOS
Wants=network-online.target
After=network-online.target flatpak-add-flathub-repos.service
ConditionPathExists=/usr/share/nicos/flatpaks/system-flatpaks.list
# Réessaie indéfiniment tant que le réseau n'est pas disponible
StartLimitIntervalSec=0

[Service]
# Type=exec et non oneshot : le démarrage (et l'écran de connexion) n'attend pas
# la fin des téléchargements, qui peuvent prendre plusieurs minutes.
Type=exec
ExecStart=/usr/libexec/nicos/nicos-flatpak-install
Restart=on-failure
RestartSec=2min
Nice=10
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
