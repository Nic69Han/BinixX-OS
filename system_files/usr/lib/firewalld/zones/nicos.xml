<?xml version="1.0" encoding="utf-8"?>
<!--
  Zone de pare-feu par défaut de NicOS. La zone FedoraWorkstation, utilisée jusqu'ici, accepte
  toute connexion entrante sur les ports 1025 à 65535 et SSH. Ici, rien n'entre sauf :
  - dhcpv6-client : configuration IPv6 du réseau ;
  - mdns : découverte des imprimantes, scanners et partages du réseau local ;
  - samba-client : réponses du voisinage réseau Windows ;
  - kdeconnect : liaison avec le téléphone (KDE Connect).
  Les réponses aux connexions sortantes passent toujours (navigation, courriel, visio).
-->
<zone>
  <short>NicOS</short>
  <description>Poste de travail : aucune connexion entrante, sauf la découverte du réseau local et KDE Connect.</description>
  <service name="dhcpv6-client"/>
  <service name="mdns"/>
  <service name="samba-client"/>
  <service name="kdeconnect"/>
</zone>
