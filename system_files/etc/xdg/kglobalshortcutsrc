# Raccourcis globaux fournis par BinixX OS (les réglages de l'utilisateur passent avant) :
# la touche Windows + I ouvre « Paramètres », comme sous Windows.
[services][binixx-parametres.desktop]
_launch=Meta+I

# Windows + S : la recherche unique (applications, réglages, logiciels Windows, aide, fichiers)
[services][binixx-recherche.desktop]
_launch=Meta+S
