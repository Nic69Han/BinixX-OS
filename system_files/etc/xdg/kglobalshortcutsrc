# Raccourcis globaux fournis par BinixX OS (les réglages de l'utilisateur passent avant) : les combinaisons de Windows
# que KDE n'offre pas d'office. La liste annoncée par la page « Raccourcis » est usr/share/binixx/raccourcis/raccourcis.tsv ;
# chaque touche de source « binixx » y doit avoir sa ligne ici (tests/image/checks.d/78-raccourcis.sh).
# Windows + I : Paramètres
[services][binixx-parametres.desktop]
_launch=Meta+I

# Windows + E : l'explorateur de fichiers (Dolphin). KDE le fournit normalement ; cette ligne le garantit.
[services][org.kde.dolphin.desktop]
_launch=Meta+E

# Windows + R : exécuter (la barre de recherche de KRunner)
[services][binixx-executer.desktop]
_launch=Meta+R

# Ctrl + Maj + Échap : gestionnaire des tâches (le Moniteur système ; Ctrl + Échap marche toujours)
[services][binixx-gestionnaire-taches.desktop]
_launch=Ctrl+Shift+Esc

# Windows + Maj + S : capturer une zone de l'écran
[services][binixx-capture-zone.desktop]
_launch=Meta+Shift+S
