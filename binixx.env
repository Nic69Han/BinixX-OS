# Paramètres de build de l'image BinixX OS (lus par le Justfile et la CI)

# Nom de l'image publiée : ghcr.io/<organisation>/<IMAGE_NAME>
IMAGE_NAME=binixx

# Compte ou organisation GitHub propriétaire du dépôt
REPO_ORGANIZATION="Nic69Han"

IMAGE_DESC="BinixX OS : poste de travail bureautique basé sur Fedora Kinoite (KDE Plasma), pensé pour les utilisateurs venant de Windows"
IMAGE_KEYWORDS="bootc,oci,linux,kde,plasma,kinoite,bureautique"

# Logo affiché sur artifacthub.io (à remplacer par le logo BinixX OS quand il existera)
IMAGE_LOGO_URL="https://avatars.githubusercontent.com/u/120078124?s=200&v=4"
# Canal de publication : chaque build est publié en « testing ». Le workflow Test VM
# promeut ensuite l'image testée vers « stable » (et « latest »), que suivent les postes.
DEFAULT_TAG="testing"
BIB_IMAGE="quay.io/centos-bootc/bootc-image-builder:latest"
